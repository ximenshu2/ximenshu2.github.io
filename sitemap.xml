---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {% assign sitemap_pages = site.pages | where_exp: "page_item", "page_item.sitemap != false" | sort: "url" %}

  {% for page_item in sitemap_pages %}
    {% unless page_item.url == '/robots.txt' or page_item.url == '/sitemap.xml' %}
  <url>
    <loc>{{ page_item.url | absolute_url }}</loc>
    {% if page_item.date_modified %}
    <lastmod>{{ page_item.date_modified | date: "%Y-%m-%d" }}</lastmod>
    {% endif %}
  </url>
    {% endunless %}
  {% endfor %}

</urlset>
